{
  "$schema": "https://scala.tauri.app/config.schema.json",
  "identifier": "splash",
  "description": "Startup splash window",
  "webviews": ["splash"],
  "remote": {
    "urls": ["http://127.0.0.1:1420/*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging"
  ]
}
