{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiAbyss",
  "version": "0.3.1",
  "identifier": "com.nick12138.pideck",
  "build": {
    "beforeDevCommand": "pnpm --filter @piabyss/desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @piabyss/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PiAbyss",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "devtools": true,
        "backgroundColor": "#111312"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": ["resources/pi-host", "resources/node", "resources/git"]
  },
  "plugins": {
    "shell": {
      "open": "https?://\\S+"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNkIwODFBOENBQkI3NTQKUldSVXQ2dU1HZ2hyM0FuN3MzWS9ud0VMT296M3VTTlIrNGFERmVmWVdiRTRTV29BeDQvSjdhSFEK",
      "endpoints": ["https://github.com/Nick12138/PiAbyss/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
