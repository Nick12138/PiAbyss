{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["test-fixtures/**"],
  "ignoreIssues": {
    "scripts/pi-host-bootstrap-runtime.mjs": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/compact-pi-host-resources.mjs",
        "scripts/package-release-macos.mjs",
        "scripts/update-node-pin.mjs"
      ],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/desktop": {
      "entry": ["src/**/*.test.{ts,tsx}", "src/widget.tsx"],
      "project": ["src/**/*.{css,ts,tsx}", "*.config.ts"]
    },
    "packages/protocol": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/pi-host": {
      "ignoreBinaries": ["where"],
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
